# Supabase project used by the frontend and backend
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Backend only: service-role key used for analysis history operations
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Required only for projects issuing HS256 access tokens.
# Projects issuing ES256/RS256 tokens use the Supabase JWKS endpoint.
SUPABASE_JWT_SECRET=

# Required for structured resume and job-description parsing
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Optional model override and frontend OAuth redirect
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
AUTH_REDIRECT_URL=http://localhost:8501
